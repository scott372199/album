{
  "name": "personal-photo-album",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Personal photo album: web frontend + serverless backend (Lambda image + S3 + CloudFront), deployed by GitHub Actions",
  "scripts": {
    "samples": "node scripts/make-samples.mjs",
    "build": "node src/build/build.mjs",
    "build:web": "node src/build/build.mjs --target=web",
    "build:all": "node src/build/build.mjs --target=all",
    "verify": "node scripts/gen-lexicon.mjs --check && node scripts/verify.mjs",
    "test": "node --test \"src/server/test/*.test.mjs\" \"src/web/test/*.test.mjs\"",
    "test:server": "node --test \"src/server/test/*.test.mjs\"",
    "test:web": "node --test \"src/web/test/*.test.mjs\"",
    "hash-key": "node scripts/hash-key.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "hook:install": "node scripts/install-hooks.mjs",
    "check:lexicon": "node scripts/gen-lexicon.mjs --check"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
