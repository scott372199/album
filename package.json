{
  "name": "personal-photo-album",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Static personal photo album: local photos and videos -> sanitized WebP/MP4 -> private S3 + CloudFront",
  "scripts": {
    "samples": "node scripts/make-samples.mjs",
    "build": "node src/build/build.mjs",
    "build:web": "node src/build/build.mjs --target=web",
    "build:all": "node src/build/build.mjs --target=all",
    "verify": "node scripts/verify.mjs",
    "test": "node --test \"src/server/test/*.test.mjs\" \"src/web/test/*.test.mjs\"",
    "test:server": "node --test \"src/server/test/*.test.mjs\"",
    "test:web": "node --test \"src/web/test/*.test.mjs\"",
    "hash-key": "node scripts/hash-key.mjs",
    "publish:apk": "node scripts/publish-apk.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "hook:install": "node scripts/install-hooks.mjs",
    "deploy": "npm run build && node src/deploy/deploy.mjs",
    "deploy:init": "node src/deploy/init.mjs",
    "deploy:dry": "node src/deploy/deploy.mjs --dry-run",
    "deploy:preview": "npm run build && node src/deploy/preview.mjs",
    "deploy:preview:dry": "node src/deploy/preview.mjs --dry-run",
    "deploy:preview:rollback": "node src/deploy/preview.mjs --rollback"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "sharp": "^0.34.0"
  },
  "engines": {
    "node": ">=20"
  }
}
