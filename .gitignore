# ---------- 依赖与构建产物 ----------
node_modules/
dist/
.build-cache.json
.build-report.json

# ---------- 运行时状态与凭据（绝不入库） ----------
# v3 的命令式部署脚本已删除，这两个文件只在旧版本里用过，留着防止意外回流
.deploy-state.json
.env
.env.*
*.pem
*.key

# ---------- 源素材：照片与视频一律不入库 ----------
# 用 photos/** 而不是 photos/*，连子目录也拦住
photos/**
!photos/.gitkeep
!photos/tags.csv
!photos/.albumignore

# ---------- 生产数据样本（绝不入库） ----------
# data/ 只应存在于 S3 站点桶；本地只在做词表审计等只读分析时临时落一份。
# 里面是真实照片 id 与识别标签，属于私人相册内容，任何情况下都不进公开仓库。
data/

# ---------- 系统与编辑器 ----------
.DS_Store
*.log
.idea/
.vscode/

# 工作区笔记（含账号/资源 ID 等内部信息，不进公开仓库）
.workbuddy/
