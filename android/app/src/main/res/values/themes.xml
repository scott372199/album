<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 状态栏/导航栏颜色与图标明暗都在 MainActivity 里用
         WindowInsetsControllerCompat 设；这里只定底色与无标题栏。
         Bar colours and icon polarity are set in code for API-level compat. -->
    <style name="Theme.Album" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
